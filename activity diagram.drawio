        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultTextAlignment center\ntitle Activity Diagram - Menu Pengaturan, Backup, &amp; Pemberitahuan\n\n|Pengguna|\nstart\n:Akses Menu Pengaturan / Pemberitahuan;\nif (Role == Ketua RT / Admin?) then (Ya)\n  |Admin|\n  :Pilih Pengaturan Sistem (Manajemen User / RBAC / Default Iuran / Backup);\n  if (Kelola Akun / RBAC?) then (Ya)\n    :Tambah/Edit Akun &amp; Atur Hak Akses Pengguna;\n  elseif (Atur Default Iuran?) then (Ya)\n    :Ubah Nominal Standar Iuran Bulanan Warga;\n  elseif (Backup &amp; Restore?) then (Ya)\n    :Jalankan Proses Cadangkan atau Pulihkan Data Sistem;\n  else (Broadcast Pengumuman)\n    :Ketik Informasi / Tagihan &amp; Kirim Broadcast;\n  endif\n  |Sistem|\n  :Simpan Konfigurasi / Jalankan Aksi Admin;\nelse (Warga / Umum)\n  |Warga|\n  :Pilih Menu Pengumuman / Notifikasi;\n  |Sistem|\n  :Tampilkan Daftar Pesan / Broadcast dari Pengurus;\nendif\n|Sistem|\n:Tampilkan Konfirmasi Berhasil;\n|Pengguna|\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hOU4L4cyNE60Esl4WZSq-340">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
