        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 01_usecase\nleft to right direction\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nskinparam ArrowColor #444444\nskinparam roundCorner 30\nskinparam actor {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n  FontStyle bold\n}\nskinparam usecase {\n  BorderColor #555555\n  FontSize 13\n}\nskinparam rectangle {\n  BorderColor #1A237E\n  BorderThickness 2\n  BackgroundColor #FFFFFF\n  FontSize 16\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \nactor \&quot;Warga\&quot; as Warga\nactor \&quot;Pengurus\\n(Ketua RT / Bendahara)\&quot; as Pengurus\nactor \&quot;Mesin OCR\\n(Google ML Kit)\&quot; as OCR\nactor \&quot;Payment Gateway\\n(QRIS)\&quot; as GW\n \nPengurus -[thickness=3]-|&gt; Warga\n \nrectangle \&quot;**USE CASE DIAGRAM**\\n**SISTEM INFORMASI KAS RT (VISIBLE)**\&quot; as SYS {\n \n  usecase \&quot;Login dengan Token\\n(4 digit / 6 digit)\&quot; as UC01 #BBDEFB\n \n  usecase \&quot;Melihat Dashboard\\n(FR-1, FR-2, FR-3)\&quot; as UC02 #C8E6C9\n  usecase \&quot;Melihat Laporan Keuangan\\n(FR-12, FR-13)\&quot; as UC03 #C8E6C9\n  usecase \&quot;Melihat Riwayat Transaksi\\n(FR-14)\&quot; as UC04 #C8E6C9\n  usecase \&quot;Mencari Riwayat Transaksi\\n(FR-15)\&quot; as UC05 #C8E6C9\n  usecase \&quot;Menerima Notifikasi\\nPengumuman (FR-20)\&quot; as UC06 #C8E6C9\n \n  usecase \&quot;Mengelola Data Warga\\n(FR-4, FR-5, FR-24)\&quot; as UC07 #FFF59D\n  usecase \&quot;Membayar Iuran Bulanan\\n(FR-6)\&quot; as UC08 #FFF59D\n  usecase \&quot;Input Iuran Manual\\n(oleh Pengurus)\&quot; as UC23 #FFF59D\n  usecase \&quot;Filter Iuran Bulan/Tahun\\n(FR-7)\&quot; as UC09 #FFF59D\n  usecase \&quot;Menandai Status\\nLunas / Belum Lunas (FR-8)\&quot; as UC10 #FFF59D\n  usecase \&quot;Membroadcast Pengumuman\\n(FR-19, FR-35)\&quot; as UC11 #FFF59D\n  usecase \&quot;Mengekspor Laporan\\n(FR-34)\&quot; as UC12 #FFF59D\n \n  usecase \&quot;Mencatat Pengeluaran\\n(FR-9)\&quot; as UC13 #F8BBD0\n  usecase \&quot;Memindai Nota (OCR)\\n(FR-10)\&quot; as UC14 #F8BBD0\n  usecase \&quot;Validasi Nominal\\nManual vs OCR (FR-11, FR-32)\&quot; as UC15 #F8BBD0\n \n  usecase \&quot;Mengelola Token &amp; Hak Akses\\n(FR-16)\&quot; as UC16 #E1BEE7\n  usecase \&quot;Mengatur Nominal\\nDefault Iuran (FR-17)\&quot; as UC17 #E1BEE7\n  usecase \&quot;Backup &amp; Restore Data\\n(FR-18, FR-36)\&quot; as UC18 #E1BEE7\n \n  usecase \&quot;Bayar via QRIS\\n(FR-25, FR-26, FR-27)\&quot; as UC19 #B2EBF2\n  usecase \&quot;Generate QRIS Dinamis\&quot; as UC20 #B2EBF2\n  usecase \&quot;Konfirmasi Pembayaran\\nOtomatis (FR-28, FR-29, FR-30)\&quot; as UC21 #B2EBF2\n  usecase \&quot;Mencatat Pemasukan\\nOnline (FR-31)\&quot; as UC22 #B2EBF2\n}\n \nWarga -- UC01\nWarga -- UC02\nWarga -- UC03\nWarga -- UC04\nWarga -- UC06\nWarga -- UC19\n \nPengurus -- UC07\nPengurus -- UC23\nPengurus -- UC11\nPengurus -- UC12\nPengurus -- UC13\nPengurus -- UC16\nPengurus -- UC17\nPengurus -- UC18\n \nUC05 -[thickness=3]-|&gt; UC04\nUC23 -[thickness=3]-|&gt; UC08\nUC19 -[thickness=3]-|&gt; UC08\nUC08 ..&gt; UC09 : &lt;&lt;include&gt;&gt;\nUC08 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\nUC13 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC15 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC03 : &lt;&lt;extend&gt;&gt;\nUC14 -- OCR\n \nUC19 ..&gt; UC20 : &lt;&lt;include&gt;&gt;\nUC19 ..&gt; UC21 : &lt;&lt;include&gt;&gt;\nUC21 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\nUC21 ..&gt; UC22 : &lt;&lt;include&gt;&gt;\nUC20 -- GW\nUC21 -- GW\n \nlegend bottom\n  |= Keterangan |= |= |= |\n  | &lt;#BBDEFB&gt;     | Autentikasi | ━━▶ | Generalisasi (pewarisan) |\n  | &lt;#C8E6C9&gt;     | Melihat data &amp; laporan | ──── | Asosiasi |\n  | &lt;#FFF59D&gt;     | Mengelola iuran &amp; warga | ╌╌▶ | Include / Extend |\n  | &lt;#F8BBD0&gt;     | Pengeluaran &amp; verifikasi nota | | Token 4 digit = Warga |\n  | &lt;#E1BEE7&gt;     | Administrasi sistem | | Token 6 digit = Pengurus |\n  | &lt;#B2EBF2&gt;     | Pemasukan online (QRIS) | | Pengurus mewarisi hak Warga |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YOD0hUAckkqSFelihf7F-1">
