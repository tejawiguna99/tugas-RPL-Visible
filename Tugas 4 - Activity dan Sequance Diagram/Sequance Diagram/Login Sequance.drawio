        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 13_sequence_login\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nhide footbox\nskinparam sequence {\n  ArrowColor #222222\n  LifeLineBorderColor #444444\n  LifeLineBackgroundColor #4FC3F7\n  GroupBorderColor #222222\n  GroupBackgroundColor #FFFFFF\n  GroupFontStyle bold\n  ParticipantFontSize 13\n}\nskinparam actor {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam boundary {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam control {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam entity {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n\nactor \&quot;pengguna\&quot; as User\nboundary \&quot;halaman login\&quot; as UI\ncontrol \&quot;proses login\&quot; as Auth\nentity \&quot;data akun\&quot; as DB\nboundary \&quot;halaman utama\&quot; as Main\n\ngroup sd login\n  activate User\n  User -&gt; UI : pilih halaman login\n  activate UI\n  UI -&gt; UI : tampilkan form ID dan password\n  User -&gt; UI : input ID dan password\n  UI -&gt; Auth : kirim ID dan password\n  activate Auth\n  Auth -&gt; DB : ambil data akun (ID)\n  activate DB\n  DB --&gt; Auth : data akun (hash password, role)\n  deactivate DB\n  Auth -&gt; Auth : verifikasi password dengan hash\\n(bcrypt / argon2)\n  alt ID &amp; password valid\n    Auth -&gt; Auth : baca role akun &amp; mulai sesi 30 menit\n    Auth -&gt; Main : tampilkan halaman sesuai role\n    activate Main\n    deactivate Main\n  else ID atau password salah\n    Auth --&gt; UI : ID atau password salah\n    UI --&gt; User : tampilkan pesan error\n  end\n  deactivate Auth\n  deactivate UI\n  deactivate User\nend\n\nnote right of Auth\n  Role (Pengurus / Warga)\n  tersimpan pada data akun\nend note\n\nlegend bottom\n  |= Ikon |= Arti |\n  | actor | Pengguna aplikasi |\n  | boundary | Halaman / antarmuka |\n  | control | Logika proses |\n  | entity | Data tersimpan |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TWO6RcFl9WY7e9JqgusB-1">
