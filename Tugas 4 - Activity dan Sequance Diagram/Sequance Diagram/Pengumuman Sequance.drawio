        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 20_sequence_pengumuman\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nhide footbox\nskinparam sequence {\n  ArrowColor #222222\n  LifeLineBorderColor #444444\n  LifeLineBackgroundColor #4FC3F7\n  GroupBorderColor #222222\n  GroupBackgroundColor #FFFFFF\n  GroupFontStyle bold\n  ParticipantFontSize 13\n}\nskinparam actor {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam boundary {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam control {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam entity {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \nactor \&quot;pengurus\&quot; as P\nboundary \&quot;form pengumuman\&quot; as Form\ncontrol \&quot;proses broadcast\&quot; as Svc\nentity \&quot;data warga &amp; pengumuman\&quot; as DB\ncontrol \&quot;layanan notifikasi\&quot; as Notif\nactor \&quot;warga\&quot; as W\nboundary \&quot;halaman pengumuman\&quot; as Inbox\n \ngroup sd broadcast pengumuman\n  activate P\n  P -&gt; Form : buka form pengumuman\n  activate Form\n  P -&gt; Form : isi judul, isi, dan pilih jenis\\n(penagihan iuran / kegiatan RT)\n  P -&gt; Form : klik kirim\n  Form -&gt; Svc : kirim pengumuman\n  activate Svc\n  Svc -&gt; Svc : validasi judul &amp; isi tidak kosong\n  alt data valid\n    Svc -&gt; DB : simpan pengumuman\n    activate DB\n    DB --&gt; Svc : tersimpan\n    alt jenis penagihan iuran\n      Svc -&gt; DB : ambil warga aktif yang belum lunas\n      DB --&gt; Svc : daftar penerima\n    else jenis kegiatan RT\n      Svc -&gt; DB : ambil semua warga aktif\n      DB --&gt; Svc : daftar penerima\n    end\n    deactivate DB\n    alt ada penerima\n      Svc -&gt; Notif : kirim notifikasi ke penerima\n      activate Notif\n      Notif --&gt; Svc : status pengiriman\n      deactivate Notif\n      Svc -&gt; DB : catat status pengiriman\n      Svc --&gt; Form : pengumuman terkirim\n      Form --&gt; P : tampilkan konfirmasi terkirim\n    else tidak ada penerima\n      Svc --&gt; Form : tidak ada penerima\n      Form --&gt; P : tampilkan info pengumuman tersimpan tanpa notifikasi\n    end\n  else data tidak valid\n    Svc --&gt; Form : error validasi\n    Form --&gt; P : tampilkan pesan kesalahan\n  end\n  deactivate Svc\n  deactivate Form\n  deactivate P\n \n  == warga menerima pengumuman ==\n \n  Notif -&gt; W : notifikasi pengumuman baru\n  activate W\n  W -&gt; Inbox : buka pengumuman\n  activate Inbox\n  Inbox -&gt; Svc : minta isi pengumuman\n  activate Svc\n  Svc -&gt; DB : ambil isi pengumuman\n  activate DB\n  DB --&gt; Svc : isi pengumuman\n  deactivate DB\n  Svc --&gt; Inbox : isi pengumuman\n  deactivate Svc\n  Inbox --&gt; W : tampilkan pengumuman\n  deactivate Inbox\n  deactivate W\nend\n \nlegend bottom\n  |= Ikon |= Arti |\n  | actor | Pengurus &amp; Warga |\n  | boundary | Halaman / antarmuka |\n  | control | Logika proses &amp; layanan notifikasi |\n  | entity | Data tersimpan |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TWO6RcFl9WY7e9JqgusB-534">
