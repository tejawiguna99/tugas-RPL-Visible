        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 14_sequence_iuran_manual\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nhide footbox\nskinparam sequence {\n  ArrowColor #222222\n  LifeLineBorderColor #444444\n  LifeLineBackgroundColor #4FC3F7\n  GroupBorderColor #222222\n  GroupBackgroundColor #FFFFFF\n  GroupFontStyle bold\n  ParticipantFontSize 13\n}\nskinparam actor {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam boundary {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam control {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam entity {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \nactor \&quot;pengurus\&quot; as B\nboundary \&quot;halaman iuran\&quot; as UI\ncontrol \&quot;proses iuran\&quot; as Svc\nentity \&quot;data iuran\&quot; as DB\n \ngroup sd input iuran manual\n  activate B\n  B -&gt; UI : buka menu iuran &amp; pilih bulan, tahun\n  activate UI\n  UI -&gt; Svc : muat data iuran (bulan, tahun)\n  activate Svc\n  Svc -&gt; DB : ambil data iuran periode\n  activate DB\n  DB --&gt; Svc : daftar warga &amp; status iuran\n  deactivate DB\n  Svc --&gt; UI : daftar iuran\n  UI --&gt; B : tampilkan daftar iuran\n \n  B -&gt; UI : pilih warga &amp; input nominal pembayaran\n  UI -&gt; Svc : simpan iuran (warga, periode, nominal)\n  Svc -&gt; Svc : validasi nominal\n  alt nominal valid\n    Svc -&gt; DB : ambil nominal default iuran\n    activate DB\n    DB --&gt; Svc : nominal default\n    deactivate DB\n    Svc -&gt; Svc : tentukan status\\n(nominal &gt;= default = Lunas, selain itu Belum Lunas)\n    Svc -&gt; DB : simpan transaksi iuran &amp; status\n    activate DB\n    DB --&gt; Svc : tersimpan\n    Svc -&gt; DB : catat riwayat transaksi (kas masuk)\n    deactivate DB\n    Svc --&gt; UI : sukses, status iuran &amp; saldo terbaru\n    UI --&gt; B : tampilkan konfirmasi iuran tersimpan\n  else nominal tidak valid\n    Svc --&gt; UI : error validasi\n    UI --&gt; B : tampilkan pesan nominal tidak valid\n  end\n  deactivate Svc\n  deactivate UI\n  deactivate B\nend\n \nlegend bottom\n  |= Ikon |= Arti |\n  | actor | Pengurus |\n  | boundary | Halaman / antarmuka |\n  | control | Logika proses |\n  | entity | Data tersimpan |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TWO6RcFl9WY7e9JqgusB-61">
