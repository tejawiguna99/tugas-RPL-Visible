        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 19_sequence_riwayat_transaksi\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nhide footbox\nskinparam sequence {\n  ArrowColor #222222\n  LifeLineBorderColor #444444\n  LifeLineBackgroundColor #4FC3F7\n  GroupBorderColor #222222\n  GroupBackgroundColor #FFFFFF\n  GroupFontStyle bold\n  ParticipantFontSize 13\n}\nskinparam actor {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam boundary {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam control {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam entity {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \nactor \&quot;pengguna\&quot; as U\nboundary \&quot;halaman riwayat\&quot; as UI\ncontrol \&quot;proses riwayat\&quot; as Svc\nentity \&quot;data transaksi\&quot; as DB\n \ngroup sd riwayat transaksi\n  activate U\n  U -&gt; UI : buka menu riwayat transaksi\n  activate UI\n  UI -&gt; Svc : minta daftar transaksi\n  activate Svc\n  Svc -&gt; DB : ambil transaksi urut waktu\n  activate DB\n  DB --&gt; Svc : daftar transaksi (kas masuk &amp; keluar)\n  deactivate DB\n  Svc --&gt; UI : daftar transaksi kronologis\n  UI --&gt; U : tampilkan riwayat\n \n  opt cari transaksi\n    U -&gt; UI : input kata kunci / filter\n    UI -&gt; Svc : cari transaksi\n    Svc -&gt; DB : query transaksi sesuai kata kunci\n    activate DB\n    DB --&gt; Svc : hasil pencarian\n    deactivate DB\n    alt data ditemukan\n      Svc --&gt; UI : daftar hasil\n      UI --&gt; U : tampilkan hasil pencarian\n    else data tidak ditemukan\n      Svc --&gt; UI : hasil kosong\n      UI --&gt; U : tampilkan \&quot;data tidak ditemukan\&quot;\n    end\n  end\n \n  opt lihat detail transaksi\n    U -&gt; UI : pilih transaksi\n    UI -&gt; Svc : minta detail transaksi\n    Svc -&gt; DB : ambil detail (termasuk foto nota untuk pengeluaran)\n    activate DB\n    DB --&gt; Svc : detail transaksi\n    deactivate DB\n    Svc --&gt; UI : detail transaksi\n    UI --&gt; U : tampilkan detail\n  end\n  deactivate Svc\n  deactivate UI\n  deactivate U\nend\n \nlegend bottom\n  |= Ikon |= Arti |\n  | actor | Warga / Pengurus |\n  | boundary | Halaman / antarmuka |\n  | control | Logika proses |\n  | entity | Data tersimpan |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TWO6RcFl9WY7e9JqgusB-465">
