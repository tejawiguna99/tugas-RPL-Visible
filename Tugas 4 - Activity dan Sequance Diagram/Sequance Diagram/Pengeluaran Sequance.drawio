        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 16_sequence_pengeluaran_ocr\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nhide footbox\nskinparam sequence {\n  ArrowColor #222222\n  LifeLineBorderColor #444444\n  LifeLineBackgroundColor #4FC3F7\n  GroupBorderColor #222222\n  GroupBackgroundColor #FFFFFF\n  GroupFontStyle bold\n  ParticipantFontSize 13\n}\nskinparam actor {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam boundary {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam control {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam entity {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \nactor \&quot;pengurus\&quot; as B\nboundary \&quot;form pengeluaran\&quot; as Form\ncontrol \&quot;proses pengeluaran\&quot; as Svc\ncontrol \&quot;mesin OCR\&quot; as OCR\nentity \&quot;data kas\&quot; as DB\n \ngroup sd pengeluaran\n  activate B\n  B -&gt; Form : buka form pengeluaran\n  activate Form\n  B -&gt; Form : pilih kategori, input nominal &amp; keterangan\n  Form -&gt; Svc : cek kewajiban nota (nominal)\n  activate Svc\n  Svc --&gt; Form : wajib nota atau opsional\n  B -&gt; Form : ambil foto nota\n  Form -&gt; Svc : kirim foto nota\n  Svc -&gt; Svc : cek ukuran maks. 2 MB &amp; format JPG/PNG\n  alt file valid\n    Svc -&gt; OCR : baca teks nota\n    activate OCR\n    OCR --&gt; Svc : teks &amp; kandidat nominal\n    deactivate OCR\n    Svc -&gt; Svc : bandingkan nominal OCR dan manual\n    alt nominal sesuai\n      Svc --&gt; Form : status Terverifikasi\n    else nominal berbeda / tidak terbaca\n      Svc --&gt; Form : status Tidak Sesuai / Tidak Terbaca\n      Form --&gt; B : minta koreksi atau foto ulang\n    end\n  else file tidak valid\n    Svc --&gt; Form : file ditolak\n    Form --&gt; B : minta ambil ulang foto\n  end\n \n  B -&gt; Form : klik simpan\n  Form -&gt; Svc : simpan pengeluaran\n  Svc -&gt; DB : simpan data &amp; foto (transaksi atomik)\n  activate DB\n  alt penyimpanan berhasil\n    DB --&gt; Svc : berhasil\n    Svc -&gt; DB : catat riwayat transaksi\n    Svc --&gt; Form : sukses &amp; saldo terbaru\n    Form --&gt; B : tampilkan pengeluaran tersimpan\n  else penyimpanan gagal\n    DB --&gt; Svc : gagal\n    Svc -&gt; DB : rollback\n    Svc --&gt; Form : gagal, data tidak hilang\n    Form --&gt; B : tampilkan pesan gagal\n  end\n  deactivate DB\n  deactivate Svc\n  deactivate Form\n  deactivate B\nend\n \nlegend bottom\n  |= Ikon |= Arti |\n  | actor | Pengurus |\n  | boundary | Halaman / antarmuka |\n  | control | Logika proses &amp; mesin OCR |\n  | entity | Data tersimpan |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TWO6RcFl9WY7e9JqgusB-217">
