        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 17_sequence_kelola_data_warga\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nhide footbox\nskinparam sequence {\n  ArrowColor #222222\n  LifeLineBorderColor #444444\n  LifeLineBackgroundColor #4FC3F7\n  GroupBorderColor #222222\n  GroupBackgroundColor #FFFFFF\n  GroupFontStyle bold\n  ParticipantFontSize 13\n}\nskinparam actor {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam boundary {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam control {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam entity {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \nactor \&quot;pengurus\&quot; as P\nboundary \&quot;halaman data warga\&quot; as UI\ncontrol \&quot;proses data warga\&quot; as Svc\nentity \&quot;data warga\&quot; as DB\n \ngroup sd kelola data warga\n  activate P\n  P -&gt; UI : buka menu data warga\n  activate UI\n  UI -&gt; Svc : minta daftar warga\n  activate Svc\n  Svc -&gt; DB : ambil data warga\n  activate DB\n  DB --&gt; Svc : daftar warga\n  deactivate DB\n  Svc --&gt; UI : daftar warga\n  UI --&gt; P : tampilkan daftar warga\n \n  alt tambah data warga\n    P -&gt; UI : input nama kepala keluarga, no. rumah, RT/RW\n    UI -&gt; Svc : simpan warga baru\n    Svc -&gt; Svc : validasi data wajib &amp; no. rumah belum terdaftar\n    alt data valid\n      Svc -&gt; DB : simpan warga (status Aktif)\n      activate DB\n      DB --&gt; Svc : tersimpan\n      deactivate DB\n      Svc --&gt; UI : sukses\n      UI --&gt; P : tampilkan warga baru di daftar\n    else data tidak valid\n      Svc --&gt; UI : error validasi\n      UI --&gt; P : tampilkan pesan kesalahan\n    end\n  else ubah data warga\n    P -&gt; UI : pilih warga &amp; ubah data\n    UI -&gt; Svc : simpan perubahan\n    Svc -&gt; DB : perbarui data warga\n    activate DB\n    DB --&gt; Svc : tersimpan\n    deactivate DB\n    Svc --&gt; UI : sukses\n    UI --&gt; P : tampilkan data terbaru\n  else hapus data warga\n    P -&gt; UI : pilih warga &amp; klik hapus\n    UI --&gt; P : minta konfirmasi hapus\n    P -&gt; UI : konfirmasi hapus\n    UI -&gt; Svc : hapus warga\n    Svc -&gt; DB : cek riwayat iuran warga\n    activate DB\n    DB --&gt; Svc : ada / tidak ada riwayat\n    deactivate DB\n    alt tidak ada riwayat iuran\n      Svc -&gt; DB : hapus data warga\n      Svc --&gt; UI : sukses\n      UI --&gt; P : tampilkan daftar terbaru\n    else memiliki riwayat iuran\n      Svc --&gt; UI : penghapusan ditolak\n      UI --&gt; P : sarankan ubah status menjadi Pindah\n    end\n  else ubah status keanggotaan\n    P -&gt; UI : pilih warga &amp; ubah status (Aktif / Pindah)\n    UI -&gt; Svc : simpan status\n    Svc -&gt; DB : perbarui status warga\n    Svc -&gt; Svc : sesuaikan daftar penagihan iuran\n    Svc --&gt; UI : sukses\n    UI --&gt; P : tampilkan status terbaru\n  end\n  deactivate Svc\n  deactivate UI\n  deactivate P\nend\n \nlegend bottom\n  |= Ikon |= Arti |\n  | actor | Pengurus |\n  | boundary | Halaman / antarmuka |\n  | control | Logika proses |\n  | entity | Data tersimpan |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TWO6RcFl9WY7e9JqgusB-300">
