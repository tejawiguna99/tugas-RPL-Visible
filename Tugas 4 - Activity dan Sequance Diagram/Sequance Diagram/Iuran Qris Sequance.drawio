        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 15_sequence_iuran_qris\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nhide footbox\nskinparam sequence {\n  ArrowColor #222222\n  LifeLineBorderColor #444444\n  LifeLineBackgroundColor #4FC3F7\n  GroupBorderColor #222222\n  GroupBackgroundColor #FFFFFF\n  GroupFontStyle bold\n  ParticipantFontSize 13\n}\nskinparam actor {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam boundary {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam control {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam entity {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \nactor \&quot;warga\&quot; as W\nboundary \&quot;halaman bayar iuran\&quot; as UI\ncontrol \&quot;proses pembayaran\&quot; as Svc\ncontrol \&quot;payment gateway\\n(QRIS)\&quot; as GW\nentity \&quot;data iuran\&quot; as DB\n \ngroup sd iuran via QRIS\n  activate W\n  W -&gt; UI : buka menu bayar iuran\n  activate UI\n  UI -&gt; Svc : minta daftar tagihan\n  activate Svc\n  Svc -&gt; DB : ambil tagihan belum lunas\n  activate DB\n  DB --&gt; Svc : daftar tagihan\n  deactivate DB\n  Svc --&gt; UI : daftar tagihan\n  UI --&gt; W : tampilkan tagihan\n \n  W -&gt; UI : pilih tagihan &amp; klik bayar dengan QRIS\n  UI -&gt; Svc : buat pembayaran (id tagihan)\n  Svc -&gt; DB : ambil nominal tagihan (nominal default)\n  activate DB\n  DB --&gt; Svc : nominal tagihan\n  deactivate DB\n  Svc -&gt; GW : buat QRIS dinamis (nominal, batas waktu)\n  activate GW\n  GW --&gt; Svc : kode QRIS &amp; id transaksi\n  deactivate GW\n  Svc -&gt; DB : simpan transaksi (status Menunggu)\n  Svc --&gt; UI : kode QRIS\n  UI --&gt; W : tampilkan QRIS &amp; hitung mundur\n \n  W -&gt; GW : scan QRIS &amp; bayar (e-wallet / m-banking)\n  activate GW\n  alt dibayar sebelum kedaluwarsa\n    GW -&gt; Svc : notifikasi pembayaran berhasil\n    Svc -&gt; Svc : verifikasi tanda tangan &amp; nominal\n    alt notifikasi valid\n      Svc -&gt; DB : status iuran = Lunas\n      activate DB\n      DB --&gt; Svc : tersimpan\n      Svc -&gt; DB : catat riwayat transaksi (kas masuk)\n      deactivate DB\n      Svc --&gt; UI : pembayaran berhasil\n      UI --&gt; W : tampilkan bukti pembayaran\n    else notifikasi tidak valid\n      Svc -&gt; DB : tandai \&quot;Perlu Ditinjau\&quot; &amp; catat log\n      Svc --&gt; UI : pembayaran sedang ditinjau\n      UI --&gt; W : tampilkan status ditinjau\n    end\n  else QRIS kedaluwarsa / gagal\n    GW -&gt; Svc : notifikasi kedaluwarsa / gagal\n    Svc -&gt; DB : status transaksi = Kedaluwarsa\n    Svc --&gt; UI : QRIS kedaluwarsa\n    UI --&gt; W : tawarkan buat QRIS baru\n  end\n  deactivate GW\n  deactivate Svc\n  deactivate UI\n  deactivate W\nend\n \nnote right of GW\n  Notifikasi dikirim gateway ke sistem\n  (callback) dan wajib diverifikasi\n  sebelum iuran ditandai Lunas.\nend note\n \nlegend bottom\n  |= Ikon |= Arti |\n  | actor | Warga |\n  | boundary | Halaman / antarmuka |\n  | control | Logika proses &amp; payment gateway |\n  | entity | Data tersimpan |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TWO6RcFl9WY7e9JqgusB-132">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
