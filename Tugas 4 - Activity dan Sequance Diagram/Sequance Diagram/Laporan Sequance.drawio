        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 18_sequence_dashboard_laporan\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nhide footbox\nskinparam sequence {\n  ArrowColor #222222\n  LifeLineBorderColor #444444\n  LifeLineBackgroundColor #4FC3F7\n  GroupBorderColor #222222\n  GroupBackgroundColor #FFFFFF\n  GroupFontStyle bold\n  ParticipantFontSize 13\n}\nskinparam actor {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam boundary {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam control {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam entity {\n  BackgroundColor #81D4FA\n  BorderColor #0277BD\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \nactor \&quot;pengguna\&quot; as U\nboundary \&quot;halaman dashboard\&quot; as Dash\nboundary \&quot;halaman laporan\&quot; as Lap\ncontrol \&quot;proses laporan\&quot; as Svc\nentity \&quot;data kas\&quot; as DB\n \ngroup sd dashboard dan laporan\n  activate U\n  U -&gt; Dash : buka dashboard\n  activate Dash\n  Dash -&gt; Svc : minta ringkasan kas\n  activate Svc\n  Svc -&gt; DB : ambil transaksi bulan berjalan &amp; status iuran\n  activate DB\n  DB --&gt; Svc : data transaksi &amp; status iuran\n  deactivate DB\n  Svc -&gt; Svc : hitung saldo kas, total pemasukan &amp; pengeluaran,\\ncari warga yang belum lunas\n  Svc --&gt; Dash : saldo, data grafik, daftar penunggak\n  Dash --&gt; U : tampilkan saldo, grafik, dan daftar penunggak\n  deactivate Dash\n \n  U -&gt; Lap : buka menu laporan keuangan\n  activate Lap\n  U -&gt; Lap : pilih periode (bulanan / tahunan)\n  Lap -&gt; Svc : minta laporan (periode)\n  Svc -&gt; DB : ambil transaksi periode\n  activate DB\n  DB --&gt; Svc : daftar transaksi\n  deactivate DB\n  Svc -&gt; Svc : susun rekap (target maks. 2 detik)\n  Svc --&gt; Lap : total pemasukan, total pengeluaran, saldo akhir\n  Lap --&gt; U : tampilkan laporan\n  opt ekspor laporan (khusus pengurus)\n    U -&gt; Lap : klik ekspor\n    Lap -&gt; Svc : minta berkas laporan\n    Svc -&gt; Svc : buat berkas laporan\n    Svc --&gt; Lap : berkas laporan\n    Lap --&gt; U : berkas siap diunduh\n  end\n  deactivate Svc\n  deactivate Lap\n  deactivate U\nend\n \nlegend bottom\n  |= Ikon |= Arti |\n  | actor | Warga / Pengurus |\n  | boundary | Halaman / antarmuka |\n  | control | Logika proses |\n  | entity | Data tersimpan |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TWO6RcFl9WY7e9JqgusB-398">
