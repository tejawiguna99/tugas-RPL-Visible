        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 08_activity_kelola_data_warga\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nskinparam roundCorner 15\nskinparam ArrowColor #333333\nskinparam titleBorderRoundCorner 12\nskinparam titleBackgroundColor #1E88E5\nskinparam titleBorderColor #1565C0\nskinparam titleFontColor #FFFFFF\nskinparam titleFontSize 18\nskinparam activity {\n  BorderColor #1E88E5\n  DiamondBackgroundColor #FFF59D\n  DiamondBorderColor #F9A825\n}\nskinparam swimlane {\n  BorderColor #1E88E5\n  BorderThickness 2\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \ntitle 6. ACTIVITY DIAGRAM KELOLA DATA WARGA\n \n|#E3F2FD|Pengurus|\nstart\n#BBDEFB:Buka menu Data Warga;\n \n|#F1F8E9|Sistem|\n#C8E6C9:Tampilkan daftar warga;\n \n|Pengurus|\nif (Aksi yang dipilih?) then (Tambah)\n  #BBDEFB:Input nama kepala keluarga,\\nno. rumah, RT/RW;\n  |Sistem|\n  #C8E6C9:Validasi data wajib &amp;\\nno. rumah belum terdaftar;\n  if (Data valid?) then (Ya)\n    #A5D6A7:Simpan warga baru\\n(status Aktif);\n  else (Tidak)\n    #F8BBD0:Tampilkan pesan kesalahan;\n  endif\nelseif (Ubah data?) then (Ubah)\n  |Pengurus|\n  #BBDEFB:Pilih warga &amp; ubah data;\n  |Sistem|\n  #C8E6C9:Validasi data;\n  if (Data valid?) then (Ya)\n    #A5D6A7:Simpan perubahan data;\n  else (Tidak)\n    #F8BBD0:Tampilkan pesan kesalahan;\n  endif\nelseif (Hapus warga?) then (Hapus)\n  |Pengurus|\n  #BBDEFB:Pilih warga &amp; klik Hapus;\n  |Sistem|\n  #C8E6C9:Minta konfirmasi hapus;\n  if (Pengurus konfirmasi?) then (Ya)\n    #C8E6C9:Cek riwayat iuran warga;\n    if (Memiliki riwayat iuran?) then (Tidak)\n      #A5D6A7:Hapus data warga;\n    else (Ya)\n      #FFE0B2:Penghapusan ditolak,\\nsarankan ubah status menjadi Pindah;\n    endif\n  else (Tidak)\n    #EEEEEE:Penghapusan dibatalkan;\n  endif\nelse (Ubah status)\n  |Pengurus|\n  #BBDEFB:Pilih warga &amp; status baru\\n(Aktif / Pindah);\n  |Sistem|\n  if (Status baru?) then (Aktif)\n    #A5D6A7:Status = **Aktif**;\n  else (Pindah)\n    #EEEEEE:Status = **Pindah**\\n(tidak ditagih);\n  endif\n  note right: FR-5\n  #C8E6C9:Sesuaikan daftar penagihan iuran;\nendif\n \n|Sistem|\n#C8E6C9:Tampilkan daftar warga terbaru;\nnote right: FR-4\n \n|Pengurus|\n#BBDEFB:Lihat hasil perubahan;\nstop\n \nlegend bottom\n  |= Warna |= Keterangan |\n  | &lt;#BBDEFB&gt; | Aksi Pengurus |\n  | &lt;#C8E6C9&gt; | Proses sistem |\n  | &lt;#A5D6A7&gt; | Berhasil disimpan / Aktif |\n  | &lt;#EEEEEE&gt; | Dibatalkan / Pindah |\n  | &lt;#FFE0B2&gt; | Ditolak |\n  | &lt;#F8BBD0&gt; | Gagal validasi |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CCQw5zI_IRy28waA-PmB-368">
