        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 09_activity_riwayat_transaksi\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nskinparam roundCorner 15\nskinparam ArrowColor #333333\nskinparam titleBorderRoundCorner 12\nskinparam titleBackgroundColor #1E88E5\nskinparam titleBorderColor #1565C0\nskinparam titleFontColor #FFFFFF\nskinparam titleFontSize 18\nskinparam activity {\n  BorderColor #1E88E5\n  DiamondBackgroundColor #FFF59D\n  DiamondBorderColor #F9A825\n}\nskinparam swimlane {\n  BorderColor #1E88E5\n  BorderThickness 2\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \ntitle 7. ACTIVITY DIAGRAM RIWAYAT TRANSAKSI\n \n|#E3F2FD|Pengguna|\nstart\n#BBDEFB:Buka menu Riwayat Transaksi;\nnote right: Semua peran hanya melihat (NFR-16)\n \n|#F1F8E9|Sistem|\n#C8E6C9:Ambil seluruh transaksi\\nurut waktu;\n#C8E6C9:Tampilkan daftar transaksi\\n(kas masuk &amp; kas keluar);\nnote right: FR-14\n \n|Pengguna|\nif (Aksi yang dipilih?) then (Cari)\n  #BBDEFB:Input kata kunci / filter;\n  |Sistem|\n  #C8E6C9:Cari transaksi sesuai kata kunci;\n  if (Data ditemukan?) then (Ya)\n    #A5D6A7:Tampilkan hasil pencarian;\n  else (Tidak)\n    #F8BBD0:Tampilkan \&quot;data tidak ditemukan\&quot;;\n  endif\n  note right: FR-15\nelseif (Lihat rincian?) then (Detail)\n  |Pengguna|\n  #BBDEFB:Pilih transaksi;\n  |Sistem|\n  #C8E6C9:Ambil rincian transaksi;\n  if (Pengeluaran dengan\\nfoto nota?) then (Ya)\n    #FFE0B2:Tampilkan rincian + foto nota;\n  else (Tidak)\n    #A5D6A7:Tampilkan rincian transaksi;\n  endif\n  note right: FR-15\nelse (Selesai)\n  |Pengguna|\n  #EEEEEE:Tetap di daftar riwayat;\nendif\n \n|Pengguna|\n#BBDEFB:Lihat hasil;\nstop\n \nlegend bottom\n  |= Warna |= Keterangan |\n  | &lt;#BBDEFB&gt; | Aksi pengguna |\n  | &lt;#C8E6C9&gt; | Proses sistem |\n  | &lt;#A5D6A7&gt; | Data berhasil ditampilkan |\n  | &lt;#FFE0B2&gt; | Pengeluaran dengan foto nota |\n  | &lt;#F8BBD0&gt; | Data tidak ditemukan |\n  | &lt;#EEEEEE&gt; | Tidak ada aksi lanjutan |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CCQw5zI_IRy28waA-PmB-497">
