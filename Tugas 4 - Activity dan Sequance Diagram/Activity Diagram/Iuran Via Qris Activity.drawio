        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 05_activity_iuran_qris\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nskinparam roundCorner 15\nskinparam ArrowColor #333333\nskinparam titleBorderRoundCorner 12\nskinparam titleBackgroundColor #1E88E5\nskinparam titleBorderColor #1565C0\nskinparam titleFontColor #FFFFFF\nskinparam titleFontSize 18\nskinparam activity {\n  BorderColor #1E88E5\n  DiamondBackgroundColor #FFF59D\n  DiamondBorderColor #F9A825\n}\nskinparam swimlane {\n  BorderColor #1E88E5\n  BorderThickness 2\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \ntitle 3. ACTIVITY DIAGRAM IURAN VIA QRIS\n \n|#E3F2FD|Warga|\nstart\n#BBDEFB:Buka menu Bayar Iuran;\n \n|#F1F8E9|Sistem|\n#C8E6C9:Tampilkan daftar tagihan iuran\\nyang belum lunas;\n \n|Warga|\n#BBDEFB:Pilih tagihan (bulan &amp; tahun);\n#BBDEFB:Klik \&quot;Bayar dengan QRIS\&quot;;\n \n|Sistem|\n#C8E6C9:Ambil nominal tagihan\\n(nominal default, FR-17);\n#C8E6C9:Kirim permintaan pembuatan QRIS;\n \n|#E0F7FA|Payment Gateway|\n#B2EBF2:Buat QRIS dinamis\\n(nominal &amp; batas waktu);\n \n|Sistem|\n#C8E6C9:Simpan transaksi (status Menunggu)\\ndan tampilkan kode QRIS + hitung mundur;\n \n|Warga|\n#BBDEFB:Scan QRIS lewat e-wallet / m-banking;\n#BBDEFB:Konfirmasi pembayaran;\n \n|Payment Gateway|\nif (Dibayar sebelum\\nQRIS kedaluwarsa?) then (Ya)\n  #B2EBF2:Proses pembayaran &amp;\\nkirim notifikasi ke sistem;\n  |Sistem|\n  #C8E6C9:Verifikasi keaslian notifikasi\\ndan kesesuaian nominal;\n  if (Notifikasi valid?) then (Ya)\n    #A5D6A7:Status iuran = **Lunas**;\n    note right: FR-8\n    #C8E6C9:Catat pemasukan ke Riwayat Transaksi;\n    note right: FR-14\n    #C8E6C9:Perbarui saldo kas &amp; Dashboard;\n    |Warga|\n    #BBDEFB:Terima bukti pembayaran\\ndan notifikasi berhasil;\n  else (Tidak)\n    |Sistem|\n    #FFE0B2:Tandai \&quot;Perlu Ditinjau\&quot;\\ndan catat log;\n  endif\nelse (Tidak)\n  |Sistem|\n  #F8BBD0:QRIS kedaluwarsa,\\ntawarkan buat QRIS baru;\nendif\nstop\n \nlegend bottom\n  |= Warna |= Keterangan |\n  | &lt;#BBDEFB&gt; | Aksi warga |\n  | &lt;#C8E6C9&gt; | Proses sistem |\n  | &lt;#B2EBF2&gt; | Payment Gateway (QRIS) |\n  | &lt;#A5D6A7&gt; | Pembayaran berhasil |\n  | &lt;#FFE0B2&gt; | Perlu ditinjau |\n  | &lt;#F8BBD0&gt; | Kedaluwarsa / gagal |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CCQw5zI_IRy28waA-PmB-117">
