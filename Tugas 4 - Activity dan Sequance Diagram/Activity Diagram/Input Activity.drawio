        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 04_activity_iuran_manual\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nskinparam roundCorner 15\nskinparam ArrowColor #333333\nskinparam titleBorderRoundCorner 12\nskinparam titleBackgroundColor #1E88E5\nskinparam titleBorderColor #1565C0\nskinparam titleFontColor #FFFFFF\nskinparam titleFontSize 18\nskinparam activity {\n  BorderColor #1E88E5\n  DiamondBackgroundColor #FFF59D\n  DiamondBorderColor #F9A825\n}\nskinparam swimlane {\n  BorderColor #1E88E5\n  BorderThickness 2\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \ntitle 2. ACTIVITY DIAGRAM INPUT IURAN (MANUAL)\n \n|#E3F2FD|Pengurus|\nstart\n#BBDEFB:Buka menu Iuran;\n#BBDEFB:Pilih bulan dan tahun;\n \n|#F1F8E9|Sistem|\n#C8E6C9:Muat data iuran sesuai filter;\nnote right: FR-7\n \n|Pengurus|\n#BBDEFB:Pilih warga (Kepala Keluarga);\n#BBDEFB:Input nominal pembayaran;\n \n|Sistem|\n#C8E6C9:Validasi nominal;\nif (Nominal valid?) then (Ya)\nelse (Tidak)\n  #F8BBD0:Tampilkan pesan nominal tidak valid;\n  stop\nendif\n#C8E6C9:Bandingkan dengan nominal default\\n(FR-17);\nif (Nominal &gt;= default?) then (Ya)\n  #A5D6A7:Status iuran = **Lunas**;\nelse (Tidak)\n  #FFE0B2:Status iuran = **Belum Lunas**;\nendif\nnote right: FR-8\n#C8E6C9:Simpan transaksi iuran;\n#C8E6C9:Catat pemasukan ke Riwayat Transaksi\\ndan perbarui saldo &amp; Dashboard;\nnote right: FR-14\n \n|Pengurus|\n#BBDEFB:Terima konfirmasi \&quot;Iuran tersimpan\&quot;;\nstop\n \nlegend bottom\n  |= Warna |= Keterangan |\n  | &lt;#BBDEFB&gt; | Aksi Pengurus |\n  | &lt;#C8E6C9&gt; | Proses sistem |\n  | &lt;#A5D6A7&gt; | Status Lunas |\n  | &lt;#FFE0B2&gt; | Status Belum Lunas |\n  | &lt;#F8BBD0&gt; | Gagal validasi |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CCQw5zI_IRy28waA-PmB-49">
