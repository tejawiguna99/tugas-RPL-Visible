        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 07_activity_laporan\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nskinparam roundCorner 15\nskinparam ArrowColor #333333\nskinparam titleBorderRoundCorner 12\nskinparam titleBackgroundColor #1E88E5\nskinparam titleBorderColor #1565C0\nskinparam titleFontColor #FFFFFF\nskinparam titleFontSize 18\nskinparam activity {\n  BorderColor #1E88E5\n  DiamondBackgroundColor #FFF59D\n  DiamondBorderColor #F9A825\n}\nskinparam swimlane {\n  BorderColor #1E88E5\n  BorderThickness 2\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \ntitle 5. ACTIVITY DIAGRAM PEMANTAUAN LAPORAN KEUANGAN\n \n|#E3F2FD|Pengguna|\nstart\n#BBDEFB:Buka menu Dashboard;\n|#F1F8E9|Sistem|\n#C8E6C9:Tampilkan saldo kas, grafik bulan berjalan,\\ndan daftar penunggak;\nnote right: FR-1, FR-2, FR-3\n \n|Pengguna|\n#BBDEFB:Buka menu Laporan Keuangan;\n#BBDEFB:Pilih periode (Bulanan / Tahunan);\n \n|Sistem|\n#C8E6C9:Susun rekapitulasi laporan;\nnote right: FR-12, maks. 2 detik (NFR-02)\n#C8E6C9:Tampilkan total pemasukan,\\ntotal pengeluaran, dan saldo akhir;\nnote right: FR-13\n \n|Pengguna|\nif (Ekspor laporan?\\n(khusus Pengurus)) then (Ya)\n  #BBDEFB:Klik tombol Ekspor;\n  |Sistem|\n  #C8E6C9:Hasilkan berkas laporan;\nelse (Tidak)\n  |Pengguna|\n  #EEEEEE:Hanya melihat laporan;\nendif\nstop\n \nlegend bottom\n  |= Warna |= Keterangan |\n  | &lt;#BBDEFB&gt; | Aksi pengguna |\n  | &lt;#C8E6C9&gt; | Proses sistem |\n  | &lt;#EEEEEE&gt; | Hanya melihat (read-only) |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CCQw5zI_IRy28waA-PmB-317">
