        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 10_activity_pengumuman\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nskinparam roundCorner 15\nskinparam ArrowColor #333333\nskinparam titleBorderRoundCorner 12\nskinparam titleBackgroundColor #1E88E5\nskinparam titleBorderColor #1565C0\nskinparam titleFontColor #FFFFFF\nskinparam titleFontSize 18\nskinparam activity {\n  BorderColor #1E88E5\n  DiamondBackgroundColor #FFF59D\n  DiamondBorderColor #F9A825\n}\nskinparam swimlane {\n  BorderColor #1E88E5\n  BorderThickness 2\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \ntitle 8. ACTIVITY DIAGRAM BROADCAST PENGUMUMAN\n \n|#E3F2FD|Pengurus|\nstart\n#BBDEFB:Buka menu Pengumuman;\n#BBDEFB:Isi judul dan isi pengumuman;\n#BBDEFB:Pilih jenis pengumuman\\n(Penagihan iuran / Kegiatan RT);\n#BBDEFB:Klik tombol Kirim;\n \n|#F1F8E9|Sistem|\n#C8E6C9:Validasi judul &amp; isi tidak kosong;\nif (Data valid?) then (Ya)\nelse (Tidak)\n  #F8BBD0:Tampilkan pesan kesalahan;\n  stop\nendif\n#C8E6C9:Simpan pengumuman;\nnote right: FR-19\nif (Jenis pengumuman?) then (Penagihan iuran)\n  #C8E6C9:Penerima = warga aktif\\nyang belum lunas;\nelse (Kegiatan RT)\n  #C8E6C9:Penerima = semua warga aktif;\nendif\nif (Ada penerima?) then (Ya)\nelse (Tidak)\n  #FFE0B2:Tidak ada penerima,\\npengumuman tersimpan tanpa notifikasi;\n  stop\nendif\n \n|#E0F7FA|Layanan Notifikasi|\n#B2EBF2:Kirim notifikasi ke penerima;\n \n|Sistem|\n#C8E6C9:Catat status pengiriman;\n \n|Pengurus|\n#BBDEFB:Terima konfirmasi\\n\&quot;Pengumuman terkirim\&quot;;\n \n|#EDE7F6|Warga|\n#D1C4E9:Terima notifikasi pengumuman baru;\nnote right: FR-20\n#D1C4E9:Buka pengumuman;\n \n|Sistem|\n#C8E6C9:Tampilkan isi pengumuman;\n \n|Warga|\n#D1C4E9:Baca pengumuman;\nstop\n \nlegend bottom\n  |= Warna |= Keterangan |\n  | &lt;#BBDEFB&gt; | Aksi pengurus |\n  | &lt;#C8E6C9&gt; | Proses sistem |\n  | &lt;#B2EBF2&gt; | Layanan notifikasi |\n  | &lt;#D1C4E9&gt; | Aksi warga |\n  | &lt;#FFE0B2&gt; | Tidak ada penerima |\n  | &lt;#F8BBD0&gt; | Gagal validasi |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CCQw5zI_IRy28waA-PmB-592">
