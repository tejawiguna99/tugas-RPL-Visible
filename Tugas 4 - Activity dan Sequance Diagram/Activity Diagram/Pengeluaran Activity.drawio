        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 06_activity_pengeluaran_nota\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam backgroundColor #FFFFFF\nskinparam roundCorner 15\nskinparam ArrowColor #333333\nskinparam titleBorderRoundCorner 12\nskinparam titleBackgroundColor #1E88E5\nskinparam titleBorderColor #1565C0\nskinparam titleFontColor #FFFFFF\nskinparam titleFontSize 18\nskinparam activity {\n  BorderColor #1E88E5\n  DiamondBackgroundColor #FFF59D\n  DiamondBorderColor #F9A825\n}\nskinparam swimlane {\n  BorderColor #1E88E5\n  BorderThickness 2\n}\nskinparam note {\n  BackgroundColor #FFFDE7\n  BorderColor #F9A825\n}\nskinparam legend {\n  BackgroundColor #FFFFFF\n  BorderColor #555555\n}\n \ntitle 4. ACTIVITY DIAGRAM PENGELUARAN &amp; VERIFIKASI NOTA OCR\n \n|#E3F2FD|Pengurus|\nstart\n#BBDEFB:Buka form Pengeluaran;\n#BBDEFB:Pilih kategori\\n(Kebersihan, Keamanan, Acara, dll);\n#BBDEFB:Input nominal manual &amp; keterangan;\n \n|#F1F8E9|Sistem|\nif (Nominal di atas\\nbatas wajib nota?) then (Ya)\n  #FFE0B2:Foto nota WAJIB;\n  note right: NFR-17\nelse (Tidak)\n  #C8E6C9:Foto nota opsional;\nendif\n \n|Pengurus|\nif (Lampirkan foto nota?) then (Ya)\n  #BBDEFB:Ambil foto nota via kamera;\n  |Sistem|\n  #C8E6C9:Cek ukuran (maks. 2 MB)\\ndan format (JPG/PNG);\n  if (File valid?) then (Ya)\n    |#EDE7F6|Mesin OCR|\n    #E1BEE7:Ekstrak teks &amp; nominal dari foto;\n    |Sistem|\n    if (Nominal terbaca?) then (Ya)\n      if (Nominal OCR =\\nnominal manual?) then (Ya)\n        #A5D6A7:Status nota = **Terverifikasi**;\n      else (Tidak)\n        #FFE0B2:Status nota = **Tidak Sesuai**\\n(tampilkan selisih);\n      endif\n    else (Tidak)\n      #FFE0B2:Status nota = **Tidak Terbaca**;\n    endif\n  else (Tidak)\n    #F8BBD0:Tolak file, minta foto ulang;\n  endif\nelse (Tidak)\n  |Sistem|\n  #EEEEEE:Status nota = **Tanpa Nota**;\nendif\n \n|Sistem|\n#C8E6C9:Simpan pengeluaran &amp; foto nota secara atomik;\nnote right: NFR-05\n#C8E6C9:Catat ke Riwayat Transaksi\\ndan kurangi saldo kas;\n|Pengurus|\n#BBDEFB:Terima konfirmasi \&quot;Pengeluaran tersimpan\&quot;;\nstop\n \nlegend bottom\n  |= Warna |= Keterangan |\n  | &lt;#BBDEFB&gt; | Aksi pengguna |\n  | &lt;#C8E6C9&gt; | Proses sistem |\n  | &lt;#E1BEE7&gt; | Mesin OCR |\n  | &lt;#A5D6A7&gt; | Terverifikasi |\n  | &lt;#FFE0B2&gt; | Perlu perhatian |\n  | &lt;#F8BBD0&gt; | Gagal / ditolak |\nendlegend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CCQw5zI_IRy28waA-PmB-217">
